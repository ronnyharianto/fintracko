# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client (Prisma 7 emits to a project-local path, not node_modules)
/generated

# supabase (local branch data — config files are tracked, ephemeral data is not)
/supabase/.branches
/supabase/.temp
