// ============================================================================
// Fintracko — Prisma Database Schema (Source of Truth)
// ============================================================================
// This schema implements the multi-tenant data contract defined in
// docs/architecture/ARCHITECTURE.md §2 ("Database Schema Design").
//
// Models (12 total):
//   1. User             — Authenticated user. (Schema: ft_auth)
//   2. AuthAccount      — OAuth provider identity linkage. (Schema: ft_auth)
//   3. Session          — HttpOnly session tokens. (Schema: ft_auth)
//   4. Verification     — OAuth/email verification tokens. (Schema: ft_auth)
//   5. Profile          — Onboarding-completion marker + user preferences. (Schema: ft_core)
//   6. Workspace        — Root multi-tenancy isolation boundary. (Schema: ft_core)
//   7. WorkspaceMember  — Collaboration access control (OWNER | COLLABORATOR). (Schema: ft_core)
//   8. FinancialAccount — Financial ledger node (Bank, Cash, Wallet). (Schema: ft_core)
//   9. Category         — Level 1 transaction classification. (Schema: ft_core)
//  10. SubCategory      — Level 2 transaction classification. (Schema: ft_core)
//  11. Budget           — Spending limit bound to a SubCategory (L2) + interval. (Schema: ft_core)
//  12. FinancialTransaction — Core financial mutation ledger entry. (Schema: ft_core)
//
// Conventions enforced everywhere:
//   - UUID primary keys via native PostgreSQL `@db.Uuid`.
//   - All financial fields use `@db.Decimal(18, 4)` for precision safety.
//   - Cascade deletes propagate along the multi-tenancy boundary so that
//     deleting a `User` or `Workspace` atomically removes all dependent rows.
//   - Compound unique keys prevent duplicate membership, duplicate account
//     names, duplicate budgets, and duplicate OAuth identity linkage.
//   - Indexes are declared explicitly on every foreign key and on the
//     hot query columns surfaced by ARCHITECTURE.md §4.
//
// IMPORTANT: This schema is `On Delete: Cascade` heavy by design. Workspace
// deletion wipes all financial data — workspace-deletion endpoints (added in
// a later task) MUST verify `WorkspaceMember.role === OWNER` before issuing
// the deletion, per the Anti-IDOR guard in ARCHITECTURE.md §3.
// ============================================================================

generator client {
  // Prisma 7 ships a new generator, `prisma-client` (replacing the legacy
  // `prisma-client-js`), and requires an explicit output path. The client
  // source is emitted to `./generated/prisma` (git-ignored) and re-imported
  // by `src/lib/db.ts` via the relative alias below.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // Prisma 7 removed support for `url` inside the schema file. The connection
  // URL now lives in `prisma.config.ts` (project root), loaded from the
  // `DATABASE_URL` environment variable via `dotenv/config`. See
  // ARCHITECTURE.md §5 and §6 for the local Supabase dev workflow.
  provider = "postgresql"
  schemas  = ["ft_auth", "ft_core"]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// Role a user holds within a specific `Workspace`.
enum WorkspaceRole {
  OWNER
  COLLABORATOR
  @@schema("ft_core")
}

/// Transaction or budget parent classification type.
enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
  @@schema("ft_core")
}

/// Identical to `CategoryType`; declared separately for the `Transaction.type`
/// column so that future divergence (e.g. a `DEPOSIT` type) does not force a
/// breaking rename of the budget-oriented `CategoryType` enum.
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  @@schema("ft_core")
}

/// Budget evaluation window.
enum BudgetInterval {
  MONTHLY
  YEARLY
  @@schema("ft_core")
}

/// Optional user demographic captured during onboarding.
enum Gender {
  MALE
  FEMALE
  OTHER
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 1. User — Identity root (Better Auth aligned)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  // Presence of a non-null value indicates the OAuth provider confirmed the
  // email. The Task 2.2 OAuth rejection guard refuses payloads whose
  // `email_verified` claim is false, and in that case this column stays null.
  emailVerified Boolean
  image         String?
  createdAt     DateTime  @default(now())
  // Required by Better Auth for session refresh / touch-on-login behavior.
  updatedAt     DateTime  @updatedAt @default(now())

  // --- Relations ---
  // One-to-one: a user has at most one profile. Deleting the user cascades.
  profile      Profile?
  // One-to-many: OAuth identity records owned by Better Auth.
  authAccounts AuthAccount[]
  // One-to-many: active session tokens owned by Better Auth.
  sessions     Session[]
  // Workspaces this user owns (via `Workspace.ownerId`).
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  // Workspaces this user is a member of.
  memberships  WorkspaceMember[]

  @@index([createdAt]) // Chronological sorting of users
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 2. AuthAccount — OAuth identity linkage (Better Auth owned)
// ----------------------------------------------------------------------------
// Named `AuthAccount` (not `Account`) to avoid a collision with the financial
// `Account` table. The mapping is wired via Better Auth's `modelMapping`
// configuration in Task 2.2. Application code must never write to this table
// directly — it is mutated exclusively by the Better Auth runtime.

model AuthAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  // OAuth provider's internal user id.
  accountId              String
  // OAuth provider identifier, e.g. "google" | "github".
  providerId             String
  userId                 String    @db.Uuid
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  // Always null for Fintracko — passwords are explicitly disabled per the
  // OAuth-only login policy in PRD_MVP1.md §3.1. The column is retained to
  // satisfy the Better Auth adapter's compiled schema contract.
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 3. Session — HttpOnly session tokens (Better Auth owned)
// ----------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 4. Verification — OAuth/email verification tokens (Better Auth owned)
// ----------------------------------------------------------------------------
// Stores short-lived verification tokens used by Better Auth during OAuth
// flows (e.g. OAuth state round-trip callbacks) and email-verification flows.
// Field contract mirrors Better Auth's `verificationSchema` exactly:
//   { id, value, identifier, expiresAt, createdAt, updatedAt }
// Created by Task 2.2 fix: the Better Auth Prisma adapter previously failed
// OAuth sign-in with "Model verification does not exist in the database"
// because neither the model nor a backing table existed. Like `AuthAccount`
// and `Session`, this table is *exclusively* mutated by the Better Auth
// runtime; application code must never write to it directly.

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  // A stable identifier Better Auth uses to look up a pending verification,
  // typically `<provider>:<userId>` or an email hash.
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  // Index for fast lookups by identifier during the OAuth callback path.
  @@index([identifier])
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 5. Profile — Onboarding completion marker + user preferences
// ----------------------------------------------------------------------------
// The presence of a `Profile` row linked to a `User` is the implicit signal
// that the user has completed onboarding (see OnboardingGuardWrapper, Task 3.1).

model Profile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  phoneNumber         String?
  company             String?
  bio                 String?
  dateOfBirth         DateTime?
  gender              Gender?
  currencyPreference  String   @default("USD")
  languagePreference  String   @default("en")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 6. Workspace — Root multi-tenancy isolation boundary
// ----------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())

  // The owning user (denormalized for fast ownership checks).
  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Members with explicit roles for access control.
  members         WorkspaceMember[]
  accounts        FinancialAccount[]
  categories      Category[]
  subCategories   SubCategory[]
  budgets         Budget[]
  transactions    FinancialTransaction[]

  @@index([ownerId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 7. WorkspaceMember — Collaboration access control
// ----------------------------------------------------------------------------

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(COLLABORATOR)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can be a member of a given workspace exactly once.
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 8. FinancialAccount — Financial ledger node (Bank, Cash, Digital Wallet, ...)
// ----------------------------------------------------------------------------
// Balance invariant (ARCHITECTURE.md §3 — Atomic Balance Updates):
//   Final Balance = initialBalance + netTransactionSum
// Every `Transaction` mutation must adjust `netTransactionSum` on the
// affected source/destination account inside a Prisma `$transaction` block.
// `initialBalance` is only touched when the user edits account settings.

model FinancialAccount {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  name               String
  initialBalance     Decimal  @default(0) @db.Decimal(18, 4)
  netTransactionSum  Decimal  @default(0) @db.Decimal(18, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Transactions where this account is the source (mandatory for
  // EXPENSE / TRANSFER).
  outgoingTransactions FinancialTransaction[] @relation("TransactionSourceAccount")
  // Transactions where this account is the destination (mandatory for
  // INCOME / TRANSFER).
  incomingTransactions FinancialTransaction[] @relation("TransactionDestinationAccount")

  // Prevents duplicate account names within the same workspace.
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 9. Category — Level 1 transaction classification
// ----------------------------------------------------------------------------

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  name        String
  type        CategoryType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]

  // Composite index for filtering categories by workspace AND type in a
  // single index range scan (e.g. dashboard "Expense Breakdown" query).
  @@index([workspaceId, type])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 10. SubCategory — Level 2 transaction classification
// ----------------------------------------------------------------------------

model SubCategory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  budgets      Budget[]
  transactions FinancialTransaction[]

  @@index([workspaceId])
  @@index([categoryId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 11. Budget — Spending limit on a SubCategory (Level 2) for an interval
// ----------------------------------------------------------------------------
// Per ARCHITECTURE.md / PRD_MVP1.md, budgets are scoped strictly to Level 2
// SubCategories. The backend guard (Task 6.1) rejects budget creation if the
// targeted `subCategoryId` resolves to a Level 1 parent node.

model Budget {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @db.Uuid
  subCategoryId String          @db.Uuid
  amount        Decimal         @db.Decimal(18, 4)
  interval      BudgetInterval
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  // Enforces "exactly one active budget per interval per sub-category".
  @@unique([subCategoryId, interval])
  @@index([subCategoryId])
  @@index([workspaceId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 12. FinancialTransaction — Core financial mutation ledger
// ----------------------------------------------------------------------------
// Account direction safeguards (enforced in the POST handler, Task 5.1):
//   - INCOME    => destinationAccountId mandatory
//   - EXPENSE   => sourceAccountId      mandatory
//   - TRANSFER  => both source & destination mandatory

model FinancialTransaction {
  id                 String          @id @default(uuid()) @db.Uuid
  workspaceId        String          @db.Uuid
  type               TransactionType
  amount             Decimal         @db.Decimal(18, 4)
  subCategoryId      String          @db.Uuid
  date               DateTime
  sourceAccountId    String?         @db.Uuid
  destinationAccountId String?       @db.Uuid
  description        String?
  payeePayer         String?
  tags               String[]
  attachmentUrl      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subCategory  SubCategory  @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  sourceAccount      FinancialAccount? @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount FinancialAccount? @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)

  // Index declarations for the hot query paths enumerated in
  // ARCHITECTURE.md §3 / §4 (time-series aggregation, type filtering,
  // autocomplete, workspace isolation, multi-tenancy Anti-IDOR lookups).
  @@index([workspaceId, type])
  @@index([workspaceId, date])
  @@index([subCategoryId])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([payeePayer])
  @@schema("ft_core")
}
