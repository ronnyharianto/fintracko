// ============================================================================
// Fintracko — Prisma Database Schema (Source of Truth)
// ============================================================================
// This schema implements the multi-tenant data contract
//
// Models (12 total):
//   1. User             — Authenticated user. (Schema: ft_auth)
//   2. AuthAccount      — OAuth provider identity linkage. (Schema: ft_auth)
//   3. Session          — HttpOnly session tokens. (Schema: ft_auth)
//   4. Verification     — OAuth/email verification tokens. (Schema: ft_auth)
//   5. Profile          — Onboarding-completion marker + user preferences. (Schema: ft_core)
//   6. Workspace        — Root multi-tenancy isolation boundary. (Schema: ft_core)
//   7. WorkspaceMember  — Collaboration access control (OWNER | COLLABORATOR). (Schema: ft_core)
//   8. FinancialAccount — Financial ledger node (Bank, Cash, Wallet). (Schema: ft_core)
//   9. Category         — Level 1 transaction classification. (Schema: ft_core)
//  10. SubCategory      — Level 2 transaction classification. (Schema: ft_core)
//  11. Budget           — Spending limit bound to a SubCategory (L2) + interval. (Schema: ft_core)
//  12. FinancialTransaction — Core financial mutation ledger entry. (Schema: ft_core)
//
// Conventions enforced everywhere:
//   - UUID primary keys via native PostgreSQL `@db.Uuid`.
//   - All financial fields use `@db.Decimal(18, 4)` for precision safety.
//   - Cascade deletes propagate along the multi-tenancy boundary so that
//     deleting a `User` or `Workspace` atomically removes all dependent rows.
//   - Compound unique keys prevent duplicate membership, duplicate account
//     names, duplicate budgets, and duplicate OAuth identity linkage.
//
// IMPORTANT: This schema is `On Delete: Cascade` heavy by design. Workspace
// deletion wipes all financial data, so it MUST verify `WorkspaceMember.role === OWNER` before issuing
// the deletion.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ft_auth", "ft_core"]
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// Role a user holds within a specific `Workspace`.
enum WorkspaceRole {
  OWNER
  COLLABORATOR

  @@schema("ft_core")
}

/// Transaction, budget, or category parent classification type.
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER

  @@schema("ft_core")
}

/// Budget evaluation window.
enum BudgetInterval {
  MONTHLY
  YEARLY
  
  @@schema("ft_core")
}

/// Optional user demographic captured during onboarding.
enum Gender {
  MALE
  FEMALE
  OTHER

  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 1. User — Identity root (Better Auth aligned)
// ----------------------------------------------------------------------------

model User {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  email           String            @unique
  emailVerified   Boolean
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt @default(now())

  profile         Profile?
  authAccounts    AuthAccount[]
  sessions        Session[]
  memberships     WorkspaceMember[]

  createdTransactions FinancialTransaction[] @relation("TransactionCreatedBy")
  updatedTransactions FinancialTransaction[] @relation("TransactionUpdatedBy")

  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 2. AuthAccount — OAuth identity linkage (Better Auth owned)
// ----------------------------------------------------------------------------
// The mapping is wired via Better Auth's `modelMapping` configuration.

model AuthAccount {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String
  providerId             String
  userId                 String    @db.Uuid
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt @default(now())

  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 3. Session — HttpOnly session tokens (Better Auth owned)
// ----------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 4. Verification — OAuth/email verification tokens (Better Auth owned)
// ----------------------------------------------------------------------------

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  @@index([identifier])
  @@schema("ft_auth")
}

// ----------------------------------------------------------------------------
// 5. Profile — Onboarding completion marker + user preferences
// ----------------------------------------------------------------------------
// The presence of a `Profile` row linked to a `User` is the implicit signal
// that the user has completed onboarding.

model Profile {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @db.Uuid
  phoneNumber         String?
  company             String?
  bio                 String?
  dateOfBirth         DateTime? @db.Date
  gender              Gender?
  currencyPreference  String    @default("USD")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt @default(now())

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 6. Workspace — Root multi-tenancy isolation boundary
// ----------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  // Members with explicit roles for access control.
  members         WorkspaceMember[]
  accounts        FinancialAccount[]
  categories      Category[]
  subCategories   SubCategory[]
  budgets         Budget[]
  transactions    FinancialTransaction[]

  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 7. WorkspaceMember — Collaboration access control
// ----------------------------------------------------------------------------

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(COLLABORATOR)
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can be a member of a given workspace exactly once.
  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 8. FinancialAccount — Financial ledger node (Bank, Cash, Digital Wallet, ...)
// ----------------------------------------------------------------------------
// Balance invariant: Final Balance = initialBalance + netTransactionSum
// Every `Transaction` mutation must adjust `netTransactionSum` on the
// affected source/destination account inside a Prisma `$transaction` block.
// `initialBalance` is only touched when the user edits account settings.

model FinancialAccount {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  name               String
  initialBalance     Decimal   @default(0) @db.Decimal(18, 4)
  netTransactionSum  Decimal   @default(0) @db.Decimal(18, 4)
  isArchived         Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt @default(now())

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Transactions where this account is the source (mandatory for EXPENSE / TRANSFER).
  outgoingTransactions FinancialTransaction[] @relation("TransactionSourceAccount")
  // Transactions where this account is the destination (mandatory for INCOME / TRANSFER).
  incomingTransactions FinancialTransaction[] @relation("TransactionDestinationAccount")

  // Prevents duplicate account names within the same workspace.
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 9. Category — Level 1 transaction classification
// ----------------------------------------------------------------------------

model Category {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @db.Uuid
  name          String
  type          TransactionType
  isArchived    Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt @default(now())

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subCategories SubCategory[]

  @@unique([workspaceId, name, type])
  // Composite index for filtering categories by workspace AND type in a
  // single index range scan (e.g. dashboard "Expense Breakdown" query).
  @@index([workspaceId, type])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 10. SubCategory — Level 2 transaction classification
// ----------------------------------------------------------------------------

model SubCategory {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  budgets      Budget[]
  transactions FinancialTransaction[]

  @@unique([workspaceId, name, categoryId])
  @@index([workspaceId])
  @@index([categoryId])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 11. Budget — Spending limit on a SubCategory (Level 2) for an interval
// ----------------------------------------------------------------------------

model Budget {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @db.Uuid
  subCategoryId String         @db.Uuid
  amount        Decimal        @db.Decimal(18, 4)
  interval      BudgetInterval

  /// Start date of the budget period (e.g., 2025-10-01).
  startDate     DateTime       @db.Date
  /// End date of the budget period (e.g., 2025-10-31 or 9999-12-31).
  endDate       DateTime       @default("9999-12-31") @db.Date

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subCategory   SubCategory    @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, subCategoryId])
  @@index([subCategoryId, startDate, endDate])
  @@schema("ft_core")
}

// ----------------------------------------------------------------------------
// 12. FinancialTransaction — Core financial mutation ledger
// ----------------------------------------------------------------------------
// Account direction safeguards (enforced in the POST handler, Task 5.1):
//   - INCOME    => destinationAccountId mandatory
//   - EXPENSE   => sourceAccountId mandatory
//   - TRANSFER  => both source & destination mandatory

model FinancialTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  workspaceId           String            @db.Uuid
  type                  TransactionType
  amount                Decimal           @db.Decimal(18, 4)
  subCategoryId         String            @db.Uuid
  date                  DateTime          @db.Date
  sourceAccountId       String?           @db.Uuid
  destinationAccountId  String?           @db.Uuid
  description           String?
  payeePayer            String?
  tags                  String[]
  attachmentUrl         String?
  createdById           String?           @db.Uuid
  createdAt             DateTime          @default(now())
  updatedById           String?           @db.Uuid
  updatedAt             DateTime          @updatedAt @default(now())

  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceAccount         FinancialAccount? @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount    FinancialAccount? @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  subCategory           SubCategory       @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  
  createdBy            User?              @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?              @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, date, type])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([payeePayer])
  @@schema("ft_core")
}
