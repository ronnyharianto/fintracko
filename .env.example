[TEMPLATE]
# ============================================================================
# Fintracko — Environment Variable Template
# ============================================================================
# Copy this file to `.env.local` (already git-ignored) and fill in real values.
# Secrets must NEVER have the NEXT_PUBLIC_ prefix unless they are intentionally
# exposed to the browser.
# ============================================================================

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Development and production both use Neon (https://neon.tech). Use an
# isolated Neon branch for local development so dev data never touches
# production.
#
# Runtime (application) connections use the POOLED endpoint (host contains
# `-pooler`) so serverless functions do not exhaust the direct connection
# limit.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"
# Prisma CLI migrations use the DIRECT endpoint (no `-pooler`); migrations
# take advisory locks and should not run through the transaction pooler.
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# --- Better Auth (populated in Task 2.2) -------------------------------------
# Random 32+ char secret used to sign session cookies. Generate locally with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# OAuth providers (Google + GitHub). Create credentials in their respective
# developer consoles; the redirect URL pattern is /api/v1/auth/callback/<provider>.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Public app origin used by Better Auth to construct absolute callback URLs.
BETTER_AUTH_URL="http://localhost:3000"

# --- SEO (public site origin, populated by the SEO task) ----------------------
# Public site origin used for SEO surfaces: canonical URLs, sitemap.xml,
# robots.txt, OpenGraph metadata, and JSON-LD structured data.
# Leave unset in production to fall back to Vercel's auto-provided
# VERCEL_PROJECT_PRODUCTION_URL (*.vercel.app); set it explicitly once a
# custom domain is connected. Local development can leave the default.
NEXT_PUBLIC_APP_URL=""

# --- Imgur Free-Tier upload (populated in Task 5.2) --------------------------
IMGUR_CLIENT_ID=""

# --- Client-side polling intervals (ms) --------------------------------------
# How often the workspace switcher polls for new invitations (default: 30000).
NEXT_PUBLIC_INVITATION_POLL_INTERVAL_MS="30000"
