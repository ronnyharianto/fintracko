# ============================================================================
# Fintracko — Environment Variable Template
# ============================================================================
# Copy this file to `.env.local` (already git-ignored) and fill in real values.
# Per docs/architecture/ARCHITECTURE.md §5, secrets must NEVER have the
# NEXT_PUBLIC_ prefix unless they are intentionally exposed to the browser.
# ============================================================================

# --- Database (Prisma + Supabase) --------------------------------------------
# Local development defaults to the Supabase CLI Docker instance.
# Production/staging points to the Supabase Cloud project connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- Better Auth (populated in Task 2.2) -------------------------------------
# Random 32+ char secret used to sign session cookies. Generate locally with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# OAuth providers (Google + GitHub). Create credentials in their respective
# developer consoles; the redirect URL pattern is /api/v1/auth/callback/<provider>.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Public app origin used by Better Auth to construct absolute callback URLs.
BETTER_AUTH_URL="http://localhost:3000"

# --- Imgur Free-Tier upload (populated in Task 5.2) --------------------------
IMGUR_CLIENT_ID=""
